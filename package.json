{
  "name": "playwright-vue-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ui:web": "playwright test --ui --ui-host=127.0.0.1 --ui-port=9412",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:slow": "SLOW_MO=1000 playwright test --headed --workers=1",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:debug:cli": "playwright test --debug=cli",
    "playwright:cli": "node node_modules/playwright-core/lib/tools/cli-client/cli.js"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
